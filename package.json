{
  "name": "vite-plugin-naive-style-isolation",
  "version": "0.1.11",
  "description": "Version-aware Naive UI style isolation for Vue and Vite micro applications",
  "license": "ISC",
  "bin": {
    "naive-style-isolation": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "node ./scripts/run-tool.mjs typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ./scripts/run-tool.mjs vitest#vitest run --config vitest.config.ts",
    "check": "npm run build && npm test && npm run typecheck && npm run check:dist",
    "check:dist": "node ./scripts/check-dist.mjs",
    "archive": "node ./scripts/archive.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/generator": "^7.24.5",
    "@babel/parser": "^7.24.5",
    "@babel/traverse": "^7.24.5",
    "@babel/types": "^7.24.5",
    "@vue/compiler-dom": "3.5.13",
    "@vue/compiler-sfc": "3.5.13",
    "fflate": "^0.8.2",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^22.12.0",
    "happy-dom": "^20.10.6",
    "less": "^4.9.1",
    "naive-ui": "2.44.1",
    "naive-ui-legacy": "npm:naive-ui@2.43.2",
    "sass": "^1.105.1",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "vite": "^6.4.0",
    "vitest": "5.0.0",
    "vue": "3.5.13"
  },
  "peerDependencies": {
    "naive-ui": ">=2.43 <3",
    "vite": ">=6 <7",
    "vue": ">=3.5 <4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YWJ-hy/vite-plugin-naive-style-isolation.git"
  },
  "homepage": "https://github.com/YWJ-hy/vite-plugin-naive-style-isolation#readme",
  "bugs": {
    "url": "https://github.com/YWJ-hy/vite-plugin-naive-style-isolation/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
